{
  "name": "credenciamento-chf2026",
  "version": "2.0.0",
  "description": "Sistema de credenciamento THB (multi-evento) — React + Express + Supabase (Hostinger)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/query-sync-storage-persister": "^5.100.14",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.100.14",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
