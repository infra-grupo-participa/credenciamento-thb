# Copie este arquivo para ".env" (local) ou configure como variáveis de
# ambiente no painel da Hostinger (Node.js App -> Environment Variables).

# ---- Banco de dados MySQL (Hostinger) ----
# Na Hostinger, o "Assistente de Conexão de Banco" preenche isso automaticamente.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coloque_o_nome_do_banco
DB_USER=coloque_o_usuario
DB_PASS=coloque_a_senha

# ---- Acesso ao app ----
# Senha do evento (todos os operadores usam esta senha para entrar).
ACCESS_PASSWORD=Clinica@102030@THB

# Segredo para assinar os tokens de login. Troque por um valor longo e aleatório.
SESSION_SECRET=troque-isto-por-uma-string-longa-e-aleatoria

# ---- Servidor ----
# A Hostinger define a PORT automaticamente; localmente usa 3000.
PORT=3000

# Arquivo de dados iniciais, importado só na primeira vez (tabela vazia).
SEED_FILE=./data.json
